# Runtime app settings for the production app container. Copy to
# .prod.app.env on the production host and update values before starting app.

# Browser-facing origin printed in invite/reset links (pnpm user:invite:prod / user:reset-link:prod).
APP_BASE_URL=https://cards.example.com
SESSION_SECRET=change-me-to-a-long-random-string
MCP_TOKEN=change-me-to-a-long-random-token
# The one account MCP tools act as. If unset or not an existing user, /mcp returns a configuration error.
MCP_USER_EMAIL=you@example.com
OPENAI_SECRET_KEY=
